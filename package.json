{
  "name": "language-flow-ai",
  "version": "0.0.0",
  "private": true,
  "description": "AI 英语短视频内容生产平台",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "dev": "concurrently -n be,fe -c blue,green \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@commitlint/types": "^19.0.0",
    "concurrently": "^10.0.4",
    "lefthook": "^1.11.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  }
}
