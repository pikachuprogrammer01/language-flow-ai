{
  "name": "language-flow-ai",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "AI 英语短视频内容生产平台",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "openapi:gen": "pnpm --filter @ai-english/backend openapi:gen",
    "openapi:check": "pnpm --filter @ai-english/backend exec vitest run src/routes/openapi-coverage.test.ts",
    "docs": "pnpm --filter @ai-english/backend dev",
    "dev": "bash scripts/stack.sh dev",
    "build": "bash scripts/stack.sh build",
    "docker:up": "bash scripts/stack.sh docker",
    "docker:release": "bash scripts/stack.sh release",
    "docker:rollback": "bash scripts/stack.sh rollback",
    "docker:version": "bash scripts/stack.sh version",
    "docker:rebuild": "bash scripts/stack.sh rebuild",
    "docker:stop": "bash scripts/stack.sh stop",
    "docker:mysql": "bash scripts/stack.sh mysql",
    "docker:test": "docker compose -f docker-compose.test.yml up -d --build",
    "docker:test:seed": "docker compose -f docker-compose.test.yml --profile seed run seeder",
    "docker:test:stop": "docker compose -f docker-compose.test.yml down",
    "prepare": "lefthook install",
    "e2e": "pnpm --filter frontend e2e",
    "e2e:full": "pnpm --filter frontend e2e:full",
    "coverage": "pnpm -r --if-present coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@commitlint/types": "^19.0.0",
    "concurrently": "^10.0.4",
    "lefthook": "^1.11.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  }
}
