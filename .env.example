# ─── 数据库 ───
DATABASE_URL=mysql://user:password@localhost:3306/language_flow

# ─── TTS 服务 ───
TTS_API_URL=https://tts.example.com/api
TTS_API_KEY=sk-xxxxxxxx

# ─── S3 兼容对象存储 ───
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=language-flow-assets
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=auto

# ─── Dify 平台 ───
DIFY_API_URL=https://dify.example.com/v1
DIFY_API_KEY=app-xxxxxxxx

# ─── 视频渲染 ───
RENDER_TEMP_DIR=/tmp/language-flow-render
BGM_DEFAULT_PATH=./assets/bgm/default.mp3

# ─── 日志 ───
LOG_LEVEL=debug
