# ─── 服务器 ───
PORT=8080

# CORS 允许来源（前端开发服务器地址）
CORS_ORIGIN=http://localhost:5173

# ─── 数据库 ───
# 本地开发可用 docker compose up -d 启动 MySQL
DATABASE_URL=mysql://dev:dev@localhost:3306/language_flow

# ─── TTS 服务 ───
# 使用微软 Edge TTS（免费、无需注册、无需API Key）
# 中文配音默认音色：zh-CN-XiaoxiaoNeural
# 音色映射表见 SPEC.md §5.2 / docs/08 §五

# ─── 对象存储（MVP 使用本地 uploads/ 目录） ───
# 部署时替换为 S3 兼容存储（见 SPEC.md）

# ─── LLM 内容生成服务（Ollama 本地离线，2026-08-17 决策） ───
# 纯本地方案：Ollama 跑 qwen2.5:7b，默认 http://localhost:11434
# 后端实际从 packages/backend/.env 读取（见 packages/backend/.env.example）
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# ─── 视频渲染 ───
RENDER_TEMP_DIR=/tmp/language-flow-render

# ─── 日志 ───
LOG_LEVEL=debug
