# ── 生产栈（language-flow-ai）版本与端口参数 ──
# 唯一作用：给 docker-compose.yml 做变量插值（image tag / 宿主端口），不参与容器内业务配置。
# 必须入库：换人 clone 后要能知道当前生产跑的是哪个版本。
# 用法：一律经 scripts/stack.sh（内部已带 --env-file），不要裸跑 docker compose 子命令。
# 语义：APP_VERSION 改动 = 生产版本改动；只改这个文件 + up -d 即可完成发布/回滚。

# 生产镜像版本 tag（由 stack.sh release 写入；rollback 手工改回旧 tag 即可）
APP_VERSION=v5cda142

# 生产 UI 宿主端口 —— 与本地 dev（5173/8080）、Docker 测试栈（5174）彻底不重叠。
# 后端 API 不映射宿主端口，只经 frontend nginx 同源反代（见 nginx.conf）。
PROD_UI_PORT=15173
