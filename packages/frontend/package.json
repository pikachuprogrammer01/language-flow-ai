{
  "name": "@ai-english/frontend",
  "version": "0.0.0",
  "private": true,
  "description": "管理面板 — Vue 3.5 + shadcn-vue + Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "gen-api": "openapi-typescript ../backend/src/openapi.json -o src/api/schema.d.ts",
    "typecheck": "pnpm gen-api && vue-tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ai-english/shared": "workspace:*",
    "@tanstack/vue-query": "^5.62.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "openapi-fetch": "^0.13.0",
    "pinia": "^3.0.0",
    "radix-vue": "^1.9.17",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^5.2.0",
    "jsdom": "^30.0.0",
    "openapi-typescript": "^7.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
