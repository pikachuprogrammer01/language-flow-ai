{
  "name": "@ai-english/frontend",
  "version": "0.0.0",
  "private": true,
  "description": "管理面板 — Vue 3.5 + shadcn-vue + Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "gen-api": "openapi-typescript ../backend/src/openapi.json -o src/api/schema.d.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-english/shared": "workspace:*",
    "openapi-fetch": "^0.13.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "@tanstack/vue-query": "^5.62.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "autoprefixer": "^10.4.0",
    "openapi-typescript": "^7.5.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
