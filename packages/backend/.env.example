# ─── 后端环境模板（dev 脚本以 `tsx watch --env-file=.env` 从本目录读取） ───
# 复制为 packages/backend/.env 后按需修改；.env 已被 gitignore，密钥不入库。

# 服务器
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# 数据库（本地可用 docker compose up -d mysql 启动）
DATABASE_URL=mysql://dev:dev@localhost:3306/language_flow

# LLM 内容生成（Ollama 本地离线方案，2026-08-17 决策）
# 先启动 Ollama 并拉模型：ollama pull qwen2.5:7b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# 视频渲染临时目录
RENDER_TEMP_DIR=/tmp/language-flow-render

# uploads 绑定挂载的宿主机目录（软链方案，见 scripts/stack.sh）
HOST_UPLOADS_DIR=

# 日志级别：debug | info | warn | error
LOG_LEVEL=debug
