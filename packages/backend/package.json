{
  "name": "@ai-english/backend",
  "version": "0.0.0",
  "private": true,
  "description": "后端 API 服务 — Hono + Drizzle + Zod",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-english/shared": "workspace:*",
    "@hono/node-server": "^2.0.12",
    "@hono/zod-openapi": "^0.18.0",
    "@hono/zod-validator": "^0.9.0",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.0.0",
    "hono-rate-limiter": "^0.5.3",
    "mysql2": "^3.12.0",
    "pino": "^10.3.1",
    "ws": "^8.21.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.30.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
