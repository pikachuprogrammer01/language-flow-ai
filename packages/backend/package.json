{
  "name": "@ai-english/backend",
  "version": "0.0.0",
  "private": true,
  "description": "后端 API 服务 — Hono + Drizzle + Zod",
  "type": "module",
  "scripts": {
    "dev": "DATABASE_URL=${DATABASE_URL:-mysql://dev:dev@localhost:3307/language_flow} UPLOADS_DIR=${UPLOADS_DIR:-$HOME/language-flow-uploads-test} HOST_UPLOADS_DIR=${HOST_UPLOADS_DIR:-$HOME/language-flow-uploads-test} tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "copy:vendor": "tsx scripts/copy-vendor.ts",
    "openapi:gen": "DATABASE_URL=${DATABASE_URL:-mysql://dev:dev@localhost:3307/language_flow} tsx --env-file=.env scripts/openapi-gen.ts",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run src/db/integration.test.ts",
    "test:watch": "vitest",
    "db:generate": "DATABASE_URL=${DATABASE_URL:-mysql://dev:dev@localhost:3307/language_flow} drizzle-kit generate",
    "db:migrate": "DATABASE_URL=${DATABASE_URL:-mysql://dev:dev@localhost:3307/language_flow} drizzle-kit migrate",
    "db:seed": "DATABASE_URL=${DATABASE_URL:-mysql://dev:dev@localhost:3307/language_flow} tsx src/db/seed.ts",
    "db:studio": "DATABASE_URL=${DATABASE_URL:-mysql://dev:dev@localhost:3307/language_flow} drizzle-kit studio",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-english/shared": "workspace:*",
    "@hono/node-server": "^2.0.12",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^0.18.4",
    "@hono/zod-validator": "^0.9.0",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.0.0",
    "hono-rate-limiter": "^0.5.3",
    "mysql2": "^3.12.0",
    "pino": "^10.3.1",
    "playwright": "^1.62.1",
    "swagger-ui-dist": "^5.33.0",
    "three": "0.160.0",
    "ws": "^8.21.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "3.2.7",
    "drizzle-kit": "^0.30.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
