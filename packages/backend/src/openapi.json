    "/api/tts/generate": {
      "post": {
        "summary": "TTS 底层接口（纯文本合成，已发布契约）",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "voice": {
                    "type": "string",
                    "default": "zh-CN-XiaoxiaoNeural"
                  }
                },
                "required": [
                  "text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "合成成功，返回音频文件信息",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "filename": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "filename",
                    "url"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "参数不合法"
          },
          "500": {
            "description": "TTS 引擎错误"
          }
        }
      }
    },
    "/api/tts/from-content": {
      "post": {
        "summary": "按模板拼接朗读文本并合成（返回音频元数据）",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": {
                        "nullable": true
                      }
                    },
                    "minItems": 1,
                    "maxItems": 100
                  },
                  "template": {
                    "type": "string",
                    "enum": [
                      "scene_word",
                      "word_card",
                      "quiz"
                    ]
                  },
                  "voice": {
                    "type": "string",
                    "default": "zh-CN-XiaoxiaoNeural"
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 100
                  }
                },
                "required": [
                  "content",
                  "template"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "合成成功（url/duration/format）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "audio": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string"
                        },
                        "duration": {
                          "type": "number"
                        },
                        "format": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "url",
                        "duration",
                        "format"
                      ]
                    }
                  },
                  "required": [
                    "audio"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "content 无法拼出文本 / 超 500 字符"
          },
          "500": {
            "description": "TTS 引擎错误"
          }
        }
      }
    },
